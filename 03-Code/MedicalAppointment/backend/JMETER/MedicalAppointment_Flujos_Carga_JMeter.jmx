def specialty = json.data?.specialty ?: json.data ?: json.specialty ?: json
def id = specialty?.id ?: json.specialty_id ?: json.data?.specialty_id
if (id) vars.put(&quot;createdSpecialtyId&quot;, id.toString())</stringProp>
