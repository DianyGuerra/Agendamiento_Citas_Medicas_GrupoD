          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Guardar adminToken" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper
def txt = prev.getResponseDataAsString()
if (!txt) return
def json = new JsonSlurper().parseText(txt)
def token = json.token ?: json.data?.token ?: json.result?.token ?: json.user?.token ?: json.data?.accessToken ?: json.accessToken
if (token) vars.put(&quot;adminToken&quot;, token.toString())
def userId = json.user?.id ?: json.data?.user?.id ?: json.data?.id ?: json.id
if (userId) vars.put(&quot;adminUserId&quot;, userId.toString())</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
