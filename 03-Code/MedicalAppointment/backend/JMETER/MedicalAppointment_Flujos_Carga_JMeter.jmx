            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper
def txt = prev.getResponseDataAsString()
if (!txt) return
def json = new JsonSlurper().parseText(txt)
def data = json.data ?: json.doctors ?: json
if (data instanceof List &amp;&amp; data.size() &gt; 0) {
    def d = data[0]
    if (d?.id) vars.put(&quot;doctorId&quot;, d.id.toString())
    if (d?.specialty_id) vars.put(&quot;specialtyId&quot;, d.specialty_id.toString())
    if (d?.user_id) vars.put(&quot;doctorUserId&quot;, d.user_id.toString())
}</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PostProcessor>
