            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper
def txt = prev.getResponseDataAsString()
if (!txt) return
def json = new JsonSlurper().parseText(txt)
def p = json.data?.patient ?: json.data ?: json.patient ?: json
if (p?.id) vars.put(&quot;patientId&quot;, p.id.toString())
if (p?.user_id) vars.put(&quot;patientUserId&quot;, p.user_id.toString())</stringProp>
