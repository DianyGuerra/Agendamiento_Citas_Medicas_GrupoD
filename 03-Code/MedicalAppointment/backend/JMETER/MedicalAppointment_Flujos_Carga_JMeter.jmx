        </HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Código HTTP esperado" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="88348176">^200$</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message">Código HTTP no esperado</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">1</intProp>
          </ResponseAssertion>
          <hashTree/>
          <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Tiempo de respuesta menor a 3000 ms" enabled="true">
            <stringProp name="DurationAssertion.duration">3000</stringProp>
          </DurationAssertion>
          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Guardar primer horario disponible" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper
def txt = prev.getResponseDataAsString()
if (!txt) return
def json = new JsonSlurper().parseText(txt)
def possible = null
if (json.data instanceof Map) {
    possible = json.data.availableSlots ?: json.data.available_slots ?: json.data.slots ?: json.data.timeSlots ?: json.data.available_times ?: json.data.availableTimes
}
if (possible == null) possible = json.availableSlots ?: json.available_slots ?: json.slots ?: json.timeSlots ?: json.available_times ?: json.availableTimes
if (possible == null &amp;&amp; json.data instanceof List) possible = json.data
if (possible == null &amp;&amp; json instanceof List) possible = json
if (!(possible instanceof List) || possible.isEmpty()) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;No se encontraron horarios disponibles en la respuesta&quot;)
    return
}
def available = possible.findAll { slot -&gt;
    if (slot instanceof String) return true
    return slot.available != false &amp;&amp; slot.is_available != false &amp;&amp; slot.isAvailable != false
}
if (available.isEmpty()) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;No hay horarios disponibles&quot;)
    return
}
int index = ctx.getThreadNum() % available.size()
def selected = available[index]
def timeValue = null
def scheduledStart = null
if (selected instanceof String) {
    timeValue = selected
} else {
    timeValue = selected.time ?: selected.start_time ?: selected.startTime ?: selected.hour ?: selected.hora
    scheduledStart = selected.scheduled_start ?: selected.scheduledStart ?: selected.start ?: selected.start_datetime ?: selected.startDateTime
}
if (timeValue) vars.put(&quot;scheduledTime&quot;, timeValue.toString())
if (!scheduledStart &amp;&amp; timeValue) {
    def offset = vars.get(&quot;timezoneOffset&quot;) ?: &quot;-05:00&quot;
    scheduledStart = vars.get(&quot;scheduledDate&quot;) + &quot;T&quot; + timeValue.toString() + &quot;:00&quot; + offset
}
if (scheduledStart) vars.put(&quot;scheduledStart&quot;, scheduledStart.toString())
log.info(&quot;Horario seleccionado para hilo &quot; + ctx.getThreadNum() + &quot;: &quot; + vars.get(&quot;scheduledStart&quot;))</stringProp>
